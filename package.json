{
  "name": "slop-meter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc -b && vite build && tsc -p tsconfig.server.json",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:hosted": "playwright test e2e/hosted-auth.spec.ts",
    "test:providers": "tsx tests/provider-smoke.ts",
    "check": "tsc -b",
    "verify": "npm run check && npm test && npm run format:check && npm run build",
    "format": "prettier --write src server tests e2e *.ts",
    "format:check": "prettier --check src server tests e2e *.ts"
  },
  "dependencies": {
    "@clerk/express": "^2.1.66",
    "@clerk/react": "^6.15.1",
    "@fontsource/inter": "^5.2.6",
    "@vercel/blob": "^2.8.0",
    "@vercel/functions": "^3.9.5",
    "express": "^5.1.0",
    "ignore": "^7.0.5",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tar": "^7.5.22",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.6",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "vite": "^7.1.4"
  }
}
