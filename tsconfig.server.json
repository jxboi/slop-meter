{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "./.vercel-build",
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "isolatedModules": false,
    "declaration": false,
    "sourceMap": true
  },
  "include": ["server/**/*.ts"],
  "exclude": ["tests", "src"]
}
